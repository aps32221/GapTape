# RPC endpoint for the target chain (BNB Smart Chain testnet in prod, local Hardhat node in dev)
RPC_URL=http://127.0.0.1:8545

# Keeper wallet — must be the `owner()` of MockOracle/LendingPool/InsurancePool.
# Default below is Hardhat's well-known account #0. Never reuse it past local dev.
KEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# HTTP port for the axum API
PORT=8080

# Path to the deploy script's address dump. Defaults to ../shared/deployments/31337.json
# DEPLOYMENT_FILE=../shared/deployments/31337.json
